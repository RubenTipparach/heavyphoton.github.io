  "triangles": 16000,
  "materials": 3,
  "texture_px": 1024,
  "textures": 5,
  "bones": 53
 },
 "height_fit": {
  "_comment": "Bisection on MPFB's height slider. MPFB drops targets under 1 % weight, so height moves in small steps near some values; the closest value within tolerance_m wins.",
  "tolerance_m": 0.005,
  "max_iterations": 30
 },
 "civilian_range": {
  "_comment": "Adults only: MPFB's own random range allows babies and 2 m+ adults. Height is drawn per sex, then clamped into height_m; the race the row pins takes race_pin_weight of the mix.",
